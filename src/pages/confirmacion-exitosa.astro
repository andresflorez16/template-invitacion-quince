---
import { invitation } from "../data/invitation";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>¡Confirmación Exitosa!</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Lato:ital,wght@0,300;0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="success">
      <div class="container">
        <!-- Icono de éxito -->
        <div class="success__icon-wrapper">
          <div class="success__icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Título -->
        <h1 class="success__title">¡Confirmación Exitosa!</h1>
        <p class="success__subtitle">Nos vemos en la fiesta</p>

        <!-- Información del evento -->
        <div class="event-info">
          <div class="event-info__section">
            <div class="event-info__icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16 2V6M8 2V6M3 10H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="event-info__content">
              <h3 class="event-info__label">Fecha</h3>
              <p class="event-info__value">{invitation.day} {invitation.date} de {invitation.month}</p>
            </div>
          </div>

          <div class="event-info__section">
            <div class="event-info__icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 6V12L16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="event-info__content">
              <h3 class="event-info__label">Hora</h3>
              <p class="event-info__value">{invitation.time}</p>
            </div>
          </div>

          <div class="event-info__section">
            <div class="event-info__icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" fill="currentColor"/>
              </svg>
            </div>
            <div class="event-info__content">
              <h3 class="event-info__label">Lugar</h3>
              <p class="event-info__value">{invitation.venue}</p>
              {invitation.address && <p class="event-info__address">{invitation.address}</p>}
              {invitation.city && <p class="event-info__address">{invitation.city}</p>}
              <a
                class="event-info__link"
                href={invitation.directionsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {invitation.directionsLabel}
              </a>
            </div>
          </div>

          <div class="event-info__section">
            <div class="event-info__icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 12V22H4V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 7H2V12H22V7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 22V7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 7H7.5C6.83696 7 6.20107 6.73661 5.73223 6.26777C5.26339 5.79893 5 5.16304 5 4.5C5 3.83696 5.26339 3.20107 5.73223 2.73223C6.20107 2.26339 6.83696 2 7.5 2C11 2 12 7 12 7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 7H16.5C17.163 7 17.7989 6.73661 18.2678 6.26777C18.7366 5.79893 19 5.16304 19 4.5C19 3.83696 18.7366 3.20107 18.2678 2.73223C17.7989 2.26339 17.163 2 16.5 2C13 2 12 7 12 7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="event-info__content">
              <h3 class="event-info__label">Regalo</h3>
              <p class="event-info__gift">{invitation.gift}</p>
            </div>
          </div>
        </div>

        <!-- Mensaje adicional -->
        <div class="message">
          <p class="message__text">
            ¡Gracias por confirmar tu asistencia! Te esperamos para celebrar juntos este momento tan especial.
          </p>
        </div>

        <!-- Acciones -->
        <div class="actions">
          <a href="/" class="btn btn--primary">Volver a la invitación</a>
        </div>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --color-rose: #d4899e;
    --color-rose-medium: #e8b4c4;
    --color-rose-light: #f5d5de;
    --color-rose-lighter: #fdf0f4;
    --color-bg: #fffbf9;
    --color-text: #4a3438;
    --color-text-light: #8a6a70;
    --color-white: #ffffff;
    --font-script: "Alex Brush", cursive;
    --font-body: "Lato", sans-serif;
  }

  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background: linear-gradient(
      180deg,
      #ffe8f0 0%,
      #fff5f9 50%,
      #fffbfc 100%
    );
    line-height: 1.6;
  }

  .success {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .container {
    max-width: 600px;
    width: 100%;
    background: white;
    border-radius: 24px;
    padding: 48px 32px;
    box-shadow: 0 8px 40px rgba(74, 52, 56, 0.12);
    text-align: center;
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .success__icon-wrapper {
    margin-bottom: 32px;
    animation: scaleIn 0.8s ease-out 0.3s backwards;
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .success__icon {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    background: linear-gradient(
      135deg,
      var(--color-rose) 0%,
      var(--color-rose-medium) 100%
    );
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(212, 137, 158, 0.3);
  }

  .success__icon svg {
    width: 40px;
    height: 40px;
    color: white;
  }

  .success__title {
    font-family: var(--font-script);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 400;
    color: var(--color-rose);
    margin-bottom: 12px;
    animation: fadeIn 0.6s ease-out 0.5s backwards;
  }

  .success__subtitle {
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 48px;
    animation: fadeIn 0.6s ease-out 0.6s backwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .event-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
    text-align: left;
  }

  .event-info__section {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--color-rose-lighter);
    border-radius: 16px;
    border: 2px solid var(--color-rose-light);
    animation: fadeIn 0.6s ease-out backwards;
  }

  .event-info__section:nth-child(1) {
    animation-delay: 0.7s;
  }

  .event-info__section:nth-child(2) {
    animation-delay: 0.8s;
  }

  .event-info__section:nth-child(3) {
    animation-delay: 0.9s;
  }

  .event-info__section:nth-child(4) {
    animation-delay: 1s;
  }

  .event-info__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-rose);
  }

  .event-info__icon svg {
    width: 24px;
    height: 24px;
  }

  .event-info__content {
    flex: 1;
  }

  .event-info__label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    margin-bottom: 4px;
  }

  .event-info__value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .event-info__gift {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.6rem, 4.5vw, 2.2rem);
    font-weight: 400;
    color: var(--color-rose);
    line-height: 1.15;
  }

  .event-info__address {
    font-size: 0.95rem;
    color: var(--color-text-light);
    margin-top: 2px;
  }

  .event-info__link {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-rose);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-info__link:hover {
    color: var(--color-text);
  }

  .message {
    padding: 24px;
    background: linear-gradient(
      135deg,
      rgba(232, 180, 196, 0.1) 0%,
      rgba(245, 213, 222, 0.1) 100%
    );
    border-radius: 16px;
    margin-bottom: 32px;
    animation: fadeIn 0.6s ease-out 1s backwards;
  }

  .message__text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .actions {
    animation: fadeIn 0.6s ease-out 1.1s backwards;
  }

  .btn {
    display: inline-block;
    padding: 16px 40px;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: white;
    background: linear-gradient(
      135deg,
      var(--color-rose) 0%,
      var(--color-rose-medium) 100%
    );
    border: none;
    border-radius: 50px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(212, 137, 158, 0.3);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(212, 137, 158, 0.4);
  }

  @media (max-width: 640px) {
    .container {
      padding: 32px 24px;
    }

    .success__icon {
      width: 64px;
      height: 64px;
    }

    .success__icon svg {
      width: 32px;
      height: 32px;
    }

    .event-info__section {
      padding: 16px;
    }

    .event-info__icon {
      width: 40px;
      height: 40px;
    }

    .event-info__icon svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
