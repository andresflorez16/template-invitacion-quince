---
import { invitation } from "../data/invitation";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{invitation.title} — {invitation.name}</title>
    <meta
      name="description"
      content={`${invitation.title} de ${invitation.name}. ${invitation.message}`}
    />
    <meta name="theme-color" content="#fdf0f4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Ornamentos decorativos en las esquinas -->
    <div class="corner-ornaments" aria-hidden="true">
      <img src="/corner.webp" alt="" class="corner-ornament corner-ornament--top-left" />
      <img src="/corner.webp" alt="" class="corner-ornament corner-ornament--top-right" />
      <img src="/corner.webp" alt="" class="corner-ornament corner-ornament--bottom-left" />
      <img src="/corner.webp" alt="" class="corner-ornament corner-ornament--bottom-right" />
    </div>
    
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-rose: #d4899e;
    --color-rose-medium: #e8b4c4;
    --color-rose-light: #f5d5de;
    --color-rose-lighter: #fdf0f4;
    --color-bg: #fffbf9;
    --color-text: #4a3438;
    --color-text-light: #8a6a70;
    --color-white: #ffffff;
    --font-script: "Alex Brush", cursive;
    --font-body: "Lato", sans-serif;
  }

  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background-color: var(--color-bg);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  [data-animate] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Ornamentos decorativos en las esquinas */
  .corner-ornaments {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
  }

  .corner-ornament {
    position: absolute;
    width: clamp(200px, 25vw, 350px);
    height: auto;
    object-fit: contain;
    opacity: 0;
    animation: fadeInCorner 1s ease-out forwards;
  }

  .corner-ornament--top-left {
    top: -5px;
    left: -5px;
    animation-delay: 0.3s;
    transform: rotate(90deg);
  }

  .corner-ornament--top-right {
    top: -5px;
    right: -5px;
    animation-delay: 0.5s;
    transform: scaleX(-1);
    transform: rotate(180deg);
  }

  .corner-ornament--bottom-left {
    bottom: -5px;
    left: -5px;
    animation-delay: 0.7s;
    transform: scaleY(-1);
    transform: rotate(0deg);
  }

  .corner-ornament--bottom-right {
    bottom: -5px;
    right: -5px;
    animation-delay: 0.9s;
    transform: scale(-1, -1);
    transform: rotate(-90deg);
  }

  @keyframes fadeInCorner {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.9;
    }
  }

  @media (max-width: 767px) {
    .corner-ornament {
      width: clamp(160px, 22vw, 240px);
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      });
    },
    { threshold: 0.15 },
  );

  document.querySelectorAll("[data-animate]").forEach((el) => {
    observer.observe(el);
  });
</script>
