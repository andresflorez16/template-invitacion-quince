---
import { invitation } from "../data/invitation";
---

<section class="invitation" aria-label="Detalles de la invitación">
  <div class="invitation__bg-blobs" aria-hidden="true"></div>

  <article class="card" data-animate>
    <div class="card__ornament" aria-hidden="true">
      <svg
        viewBox="0 0 120 40"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="ornament-svg"
      >
        <path
          d="M60 4C55 4 48 8 44 14C40 8 33 4 28 4C18 4 12 12 12 20C12 32 28 38 44 38C48 36 52 34 56 30"
          stroke="var(--color-rose-light)"
          stroke-width="1"
          fill="none"
          opacity="0.6"></path>
        <path
          d="M60 4C65 4 72 8 76 14C80 8 87 4 92 4C102 4 108 12 108 20C108 32 92 38 76 38C72 36 68 34 64 30"
          stroke="var(--color-rose-light)"
          stroke-width="1"
          fill="none"
          opacity="0.6"></path>
        <circle cx="60" cy="6" r="2" fill="var(--color-rose-medium)" opacity="0.5"
        ></circle>
      </svg>
    </div>

    <h1 class="card__title">{invitation.title}</h1>

    <p class="card__message">{invitation.message}</p>

    <p class="card__name">{invitation.name}</p>

    <div class="card__divider" aria-hidden="true">
      <span class="divider-line"></span>
      <svg
        viewBox="0 0 16 16"
        class="divider-dot"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M8 2L9.5 6H14L10.5 9L12 14L8 11L4 14L5.5 9L2 6H6.5L8 2Z"
          fill="var(--color-rose-medium)"
          opacity="0.5"></path>
      </svg>
      <span class="divider-line"></span>
    </div>

    <div class="card__date" data-animate>
      <div class="date__row">
        <span class="date__label">{invitation.day}</span>
        <span class="date__separator" aria-hidden="true"></span>
        <span class="date__number">{invitation.date}</span>
        <span class="date__separator" aria-hidden="true"></span>
        <span class="date__label">{invitation.time}</span>
      </div>
      <span class="date__month">{invitation.month}</span>
    </div>

    <div class="card__divider" aria-hidden="true">
      <span class="divider-line"></span>
      <svg
        viewBox="0 0 16 16"
        class="divider-dot"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M8 2L9.5 6H14L10.5 9L12 14L8 11L4 14L5.5 9L2 6H6.5L8 2Z"
          fill="var(--color-rose-medium)"
          opacity="0.5"></path>
      </svg>
      <span class="divider-line"></span>
    </div>

    <address class="card__venue" data-animate>
      <svg
        viewBox="0 0 24 24"
        class="venue-icon"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z"
          fill="var(--color-rose)"
          opacity="0.6"></path>
      </svg>
      <p class="venue__name">{invitation.venue}</p>
      <p class="venue__address">{invitation.address}</p>
      <p class="venue__city">{invitation.city}</p>
    </address>

    <div class="card__action" data-animate>
      <button class="btn" type="button">Confirmar asistencia</button>
    </div>
  </article>
</section>

<style>
  .invitation {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
  }

  .invitation__bg-blobs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        ellipse 600px 500px at 5% 15%,
        rgba(244, 185, 201, 0.14) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 500px 400px at 95% 50%,
        rgba(244, 185, 201, 0.1) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 600px 500px at 50% 90%,
        rgba(244, 185, 201, 0.12) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 300px 300px at 20% 70%,
        rgba(232, 180, 196, 0.08) 0%,
        transparent 70%
      );
  }

  .card {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: var(--color-white);
    border-radius: 24px;
    padding: 48px 32px;
    box-shadow:
      0 4px 32px rgba(74, 52, 56, 0.06),
      0 1px 4px rgba(74, 52, 56, 0.03);
    text-align: center;
    z-index: 1;
  }

  .card__ornament {
    display: flex;
    justify-content: center;
    margin-bottom: 8px;
  }

  .ornament-svg {
    width: 80px;
    height: auto;
  }

  .card__title {
    font-family: var(--font-script);
    font-size: clamp(2rem, 7vw, 2.8rem);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .card__message {
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--color-text-light);
    line-height: 1.7;
    max-width: 320px;
    margin: 0 auto 24px;
  }

  .card__name {
    font-family: var(--font-script);
    font-size: clamp(2.5rem, 10vw, 3.6rem);
    font-weight: 400;
    color: var(--color-rose);
    line-height: 1.2;
    margin-bottom: 24px;
  }

  .card__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 20px 0;
  }

  .divider-line {
    flex: 1;
    max-width: 100px;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--color-rose-light),
      transparent
    );
  }

  .divider-dot {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .card__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .date__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .date__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-text-light);
  }

  .date__separator {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-rose-medium);
  }

  .date__number {
    font-family: var(--font-script);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-rose);
  }

  .date__month {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-text-light);
    margin-top: 2px;
  }

  .card__venue {
    font-style: normal;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .venue-icon {
    width: 24px;
    height: 24px;
    margin-bottom: 6px;
  }

  .venue__name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .venue__address,
  .venue__city {
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--color-text-light);
  }

  .card__action {
    margin-top: 32px;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-white);
    background: linear-gradient(
      135deg,
      var(--color-rose) 0%,
      var(--color-rose-medium) 100%
    );
    border: none;
    border-radius: 50px;
    padding: 14px 40px;
    cursor: pointer;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    box-shadow: 0 4px 16px rgba(212, 137, 158, 0.3);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(212, 137, 158, 0.4);
  }

  .btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(212, 137, 158, 0.3);
  }

  @media (min-width: 768px) {
    .invitation {
      padding: 80px 24px;
    }

    .card {
      padding: 56px 48px;
      max-width: 500px;
    }
  }
</style>
